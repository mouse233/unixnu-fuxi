diff --git a/DarwinBootPkg/Driver/WindowProbe.h b/DarwinBootPkg/Driver/WindowProbe.h
new file mode 100644
--- /dev/null
+++ b/DarwinBootPkg/Driver/WindowProbe.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef DARWINBOOT_WINDOW_PROBE_H
+#define DARWINBOOT_WINDOW_PROBE_H
+
+// Sparse diagnostic only: one 64-bit word per 2 MiB and the final word.
+// All address tags are written before reading any of them, detecting aliases
+// between sampled addresses as well as stuck bits. The caller owns the entire
+// allocation; firmware never probes arbitrary FDT addresses or free memory.
+// READ/WRITE include cache maintenance in firmware; tests substitute faulty RAM.
+#define DARWIN_PROBE_STEP 0x200000ULL
+static inline unsigned long long DarwinProbeOffset(unsigned long long index,
+                                                   unsigned long long size) {
+  return index < size / DARWIN_PROBE_STEP ? index * DARWIN_PROBE_STEP : size - 8;
+}
+static inline int DarwinWindowProbe(unsigned long long base, unsigned long long size,
+                                    unsigned long long *saved, unsigned long long *failed) {
+  unsigned long long count = size / DARWIN_PROBE_STEP + 1;
+  unsigned long long i, address, expected;
+  unsigned pass;
+  int ok = 1;
+  for (i = 0; i < count; ++i) {
+    address = base + DarwinProbeOffset(i, size);
+    saved[i] = DARWIN_PROBE_READ(address);
+  }
+  for (pass = 0; pass < 2 && ok; ++pass) {
+    for (i = 0; i < count; ++i) {
+      address = base + DarwinProbeOffset(i, size);
+      expected = address ^ 0xa55aa55a5aa55aa5ULL;
+      DARWIN_PROBE_WRITE(address, pass ? ~expected : expected);
+    }
+    for (i = 0; i < count; ++i) {
+      address = base + DarwinProbeOffset(i, size);
+      expected = address ^ 0xa55aa55a5aa55aa5ULL;
+      if (DARWIN_PROBE_READ(address) != (pass ? ~expected : expected)) {
+        *failed = address;
+        ok = 0;
+        break;
+      }
+    }
+  }
+  for (i = 0; i < count; ++i) {
+    address = base + DarwinProbeOffset(i, size);
+    DARWIN_PROBE_WRITE(address, saved[i]);
+  }
+  return ok;
+}
+#endif
diff --git a/Test/window-probe.c b/Test/window-probe.c
new file mode 100644
--- /dev/null
+++ b/Test/window-probe.c
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#define BASE 0xa00004000ULL
+#define SIZE 0x300000000ULL
+#define COUNT (SIZE / 0x200000ULL + 1)
+static unsigned long long words[COUNT], before[COUNT], saved[COUNT];
+static int alias, stuck;
+static unsigned long long slot(unsigned long long address) {
+  assert(address >= BASE && address <= BASE + SIZE - 8);
+  unsigned long long offset = address - BASE;
+  assert(offset == SIZE - 8 || offset % 0x200000ULL == 0);
+  unsigned long long index = offset == SIZE - 8 ? COUNT - 1 : offset / 0x200000ULL;
+  if (alias && index == COUNT - 2) index = 0;
+  return index;
+}
+static unsigned long long read_word(unsigned long long address) {
+  return words[slot(address)];
+}
+static void write_word(unsigned long long address, unsigned long long value) {
+  words[slot(address)] = stuck ? value & ~1ULL : value;
+}
+#define DARWIN_PROBE_READ(address) read_word(address)
+#define DARWIN_PROBE_WRITE(address, value) write_word(address, value)
+#include "../DarwinBootPkg/Driver/WindowProbe.h"
+int main(void) {
+  unsigned long long failed = 0;
+  for (unsigned i = 0; i < COUNT; ++i) words[i] = before[i] = i * 0x12345678ULL;
+  assert(DarwinWindowProbe(BASE, SIZE, saved, &failed));
+  assert(memcmp(words, before, sizeof(words)) == 0);
+  alias = 1;
+  assert(!DarwinWindowProbe(BASE, SIZE, saved, &failed));
+  assert(failed == BASE);
+  assert(memcmp(words, before, sizeof(words)) == 0);
+  alias = 0; stuck = 1;
+  assert(!DarwinWindowProbe(BASE, SIZE, saved, &failed));
+  assert(failed >= BASE && failed < BASE + SIZE);
+  assert(memcmp(words, before, sizeof(words)) == 0);
+  printf("PASS: 12 GiB range, %llu samples, address alias/stuck-bit detection, restoration\n", COUNT);
+}
